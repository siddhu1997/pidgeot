APP_BASE_URL=http://localhost:3000
GITHUB_URL=https://github.com/siddhu1997/pidgeot
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=24
PROCESSING_LEASE_TTL_SECONDS=120
SCAN_PAGE_SIZE=50
DEV_SCAN_MESSAGE_LIMIT=50
SCAN_METADATA_CONCURRENCY=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
